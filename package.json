{
  "name": "gluesql",
  "version": "0.20.0",
  "description": "GlueSQL is quite sticky, it attaches to anywhere",
  "browser": "gluesql.js",
  "main": "gluesql.node.js",
  "exports": {
    ".": {
      "browser": "./gluesql.js",
      "default": "./gluesql.node.js"
    },
    "./opfs": "./gluesql.opfs.js",
    "./gluesql.js": "./gluesql.js",
    "./gluesql.rollup.js": "./gluesql.rollup.js",
    "./package.json": "./package.json",
    "./opfs/shared": "./gluesql.opfs.shared.js"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:node",
    "build:web": "wasm-pack build --no-pack --target web --no-typescript --release --out-dir ./dist_web",
    "build:opfs": "wasm-pack build --no-pack --target web --no-typescript --release --out-dir ./dist_opfs -- --features opfs",
    "build:node": "napi build --release --platform --js gluesql.native.js --dts gluesql.native.d.ts --no-default-features --features nodejs",
    "build:node:full": "napi build --release --platform --js gluesql.native.js --dts gluesql.native.d.ts --no-default-features --features full",
    "test:node": "node --test \"tests/node/*.test.js\"",
    "test:browser": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gluesql/gluesql-js.git"
  },
  "keywords": [
    "SQL",
    "Database",
    "SQL.js",
    "websql",
    "rust",
    "webassembly",
    "wasm"
  ],
  "author": "Taehoon Moon",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/gluesql/gluesql-js/issues"
  },
  "homepage": "https://gluesql.org/docs",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "gluesql.native.js",
    "gluesql.native.d.ts",
    "dist_web/gluesql_js.js",
    "dist_web/gluesql_js_bg.wasm",
    "dist_opfs/gluesql_js.js",
    "dist_opfs/gluesql_js_bg.wasm",
    "gluesql.js",
    "gluesql.node.js",
    "gluesql.opfs.js",
    "gluesql.opfs.worker.js",
    "gluesql.opfs.shared.js",
    "gluesql.rollup.js",
    "gluesql_js.*.node",
    "package.json",
    "README.md"
  ],
  "napi": {
    "binaryName": "gluesql_js",
    "packageName": "@gluesql/native",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.1",
    "@playwright/test": "^1.62.0",
    "wasm-pack": "^0.13.1"
  }
}
